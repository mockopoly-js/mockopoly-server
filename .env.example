# Server port (default: 3001)
PORT=3001

# CORS origin — set to your client URL
CLIENT_URL=http://localhost:5173

# Room code length (default: 6)
ROOM_CODE_LENGTH=6

# Max players per room (default: 4)
MAX_PLAYERS=4

# Idle room timeout in minutes before auto-cleanup (default: 60)
ROOM_TIMEOUT_MINUTES=60
